{
  "name": "headless-framework",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "src/Headless.Dashboard/wwwroot",
    "src/Headless.Dashboard/wwwroot/packages/sdk",
    "src/Headless.Dashboard/wwwroot/packages/vite",
    "src/Headless.Dashboard/wwwroot/apps/shell",
    "src/Headless.Jobs.Dashboard/wwwroot",
    "src/Headless.Messaging.Dashboard/wwwroot"
  ],
  "scripts": {
    "format": "prettier --write src/Headless.Dashboard/wwwroot src/Headless.Jobs.Dashboard/wwwroot src/Headless.Messaging.Dashboard/wwwroot",
    "format:check": "prettier --check src/Headless.Dashboard/wwwroot src/Headless.Jobs.Dashboard/wwwroot src/Headless.Messaging.Dashboard/wwwroot"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
