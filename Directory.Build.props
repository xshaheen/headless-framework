<Project>
  <PropertyGroup>
    <!-- Off by default: writing every generator's output to obj/generated costs disk on each of the
         ~430 projects' compiles and nothing in this repository or its tests reads those files. Set
         HeadlessEmitGeneratedFiles=true (property or environment variable) when inspecting what a
         source generator actually produced. -->
    <EmitCompilerGeneratedFiles Condition="'$(HeadlessEmitGeneratedFiles)' == 'true'">true</EmitCompilerGeneratedFiles>
    <LangVersion>14.0</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true'"
      >true</RestoreLockedMode>
    <GenerateSBOM Condition="'$(GenerateSBOM)' == ''">true</GenerateSBOM>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <Using Include="JetBrains.Annotations" />
  </ItemGroup>
  <ItemGroup Label="Analyzer configuration">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/analyzers/*.txt" />
  </ItemGroup>
</Project>
