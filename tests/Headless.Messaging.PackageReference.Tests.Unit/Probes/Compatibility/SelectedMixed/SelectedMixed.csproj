<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605</WarningsAsErrors>
    <MessagingPackageVersion Condition="'$(MessagingPackageVersion)' == ''"
      >0.0.0-local-required</MessagingPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Headless.Messaging.Core" Version="0.11.0" />
    <PackageReference Include="Headless.Messaging.Redis" Version="$(MessagingPackageVersion)" />
  </ItemGroup>
</Project>
