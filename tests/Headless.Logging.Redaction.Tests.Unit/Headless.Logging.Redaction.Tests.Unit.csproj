<Project Sdk="Headless.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Ships the [LoggerMessage] generator that emits classified parameters; package analyzers do not flow transitively. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <!-- Drives the scrubber under a template-rendering provider, which ignores the formatter output. -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Logging.Redaction\Headless.Logging.Redaction.csproj" />
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
  </ItemGroup>
</Project>
