<Project Sdk="Headless.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- The package leaves the native libvips choice to the application; the tests take the bundled binaries. -->
    <PackageReference Include="NetVips.Native" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Imaging.NetVips\Headless.Imaging.NetVips.csproj" />
    <ProjectReference Include="..\..\src\Headless.Imaging\Headless.Imaging.csproj" />
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
  </ItemGroup>
</Project>
