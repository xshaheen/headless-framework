<Project Sdk="Headless.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixture module builds: each folder stands in for one module's embedded Vite output. -->
    <EmbeddedResource Include="Modules\Fixtures\**\manifest.json" />
    <!-- A fake shell build (dist) and module builds, embedded the way the packages embed their real builds. -->
    <EmbeddedResource Include="Serving\Fixtures\**\*" Exclude="Serving\Fixtures\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Dashboard\Headless.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
  </ItemGroup>
</Project>
