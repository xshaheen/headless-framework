{
  "id": "diag",
  "sdkVersion": "1.0.0",
  "entry": "entry.js",
  "nav": [
    { "id": "diag.nav.runs", "label": "Runs", "to": "runs" },
    { "id": "diag.nav.overview", "label": "Overview", "to": "overview" },
    { "id": "diag.nav.settings", "label": "Settings", "to": "settings", "requires": "operate" }
  ],
  "routes": [
    { "path": "runs", "chunk": "runs.js" },
    { "path": "overview", "chunk": "overview.js" },
    { "path": "settings", "chunk": "settings.js" }
  ],
  "objectKinds": { "run": { "route": "runs/:id" } },
  "commands": [{ "id": "diag.open-runs", "label": "Open runs" }],
  "events": ["diag.run.updated"]
}
