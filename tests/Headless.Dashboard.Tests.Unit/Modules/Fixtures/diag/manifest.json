{
  "id": "diag",
  "sdkVersion": "1.0.0",
  "entry": "entry.js",
  "product": "diagnostics",
  "sidebar": [
    {
      "entries": [
        {
          "id": "diag.nav.runs",
          "label": "Runs",
          "route": "runs",
          "icon": "list"
        },
        {
          "id": "diag.nav.overview",
          "label": "Overview",
          "route": "overview",
          "icon": "list"
        },
        {
          "id": "diag.nav.settings",
          "label": "Settings",
          "route": "settings",
          "icon": "list",
          "requires": "operate"
        }
      ]
    }
  ],
  "routes": [
    {
      "path": "runs",
      "chunk": "runs.js"
    },
    {
      "path": "overview",
      "chunk": "overview.js"
    },
    {
      "path": "settings",
      "chunk": "settings.js"
    }
  ],
  "objectKinds": {
    "run": {
      "route": "runs/:id"
    }
  },
  "commands": [
    {
      "id": "diag.open-runs",
      "label": "Open runs"
    }
  ],
  "events": [
    "diag.run.updated"
  ]
}
