<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsTestHarnessProject>true</IsTestHarnessProject>
    <!-- ReferenceTrimmer sees only what the compiler marks used; this project builds generator compilations at run time from the loaded assemblies. -->
    <EnableReferenceTrimmer>false</EnableReferenceTrimmer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
  </ItemGroup>
</Project>
