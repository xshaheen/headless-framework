<Project Sdk="Headless.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tests</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsTestHarnessProject>true</IsTestHarnessProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- AddHeadlessTenancy, which the upload endpoint scenarios scope uploads by tenant through, lives in Headless.MultiTenancy. -->
    <ProjectReference Include="..\..\src\Headless.MultiTenancy\Headless.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
    <!-- TreatAsUsed: supplies the tusdotnet store contracts and MapTus the scenarios run against. -->
    <ProjectReference Include="..\..\src\Headless.Tus\Headless.Tus.csproj" TreatAsUsed="true" />
  </ItemGroup>
</Project>
