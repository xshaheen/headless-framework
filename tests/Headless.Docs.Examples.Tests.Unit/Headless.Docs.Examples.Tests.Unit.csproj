<Project Sdk="Headless.NET.Sdk.Test">
  <PropertyGroup>
    <RootNamespace>Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- ReferenceTrimmer sees only what the compiler marks used; this project compiles the documented examples at run time against these assemblies. -->
    <EnableReferenceTrimmer>false</EnableReferenceTrimmer>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup Label="Packages the documented examples call">
    <ProjectReference Include="..\..\src\Headless.Api\Headless.Api.csproj" />
    <ProjectReference Include="..\..\src\Headless.Caching.InMemory\Headless.Caching.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Headless.Caching.Redis\Headless.Caching.Redis.csproj" />
    <ProjectReference Include="..\..\src\Headless.Cluster.Dashboard\Headless.Cluster.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Coordination.PostgreSql\Headless.Coordination.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Coordination.SqlServer\Headless.Coordination.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Headless.Idempotency.Dashboard\Headless.Idempotency.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Idempotency.InMemory\Headless.Idempotency.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Headless.DistributedLocks.PostgreSql\Headless.DistributedLocks.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Fencing.PostgreSql\Headless.Fencing.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Jobs\Headless.Jobs.csproj" />
    <ProjectReference Include="..\..\src\Headless.DevInbox.Dashboard\Headless.DevInbox.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Jobs.Dashboard\Headless.Jobs.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Jobs.EntityFramework\Headless.Jobs.EntityFramework.csproj" />
    <ProjectReference Include="..\..\src\Headless.Jobs.EntityFramework.PostgreSql\Headless.Jobs.EntityFramework.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Jobs.EntityFramework.SqlServer\Headless.Jobs.EntityFramework.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Headless.Leases.Dashboard\Headless.Leases.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Aws\Headless.Messaging.Aws.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.AzureServiceBus\Headless.Messaging.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging\Headless.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Headless.Dashboard\Headless.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Encryption\Headless.Encryption.csproj" />
    <ProjectReference Include="..\..\src\Headless.Encryption.EntityFramework\Headless.Encryption.EntityFramework.csproj" />
    <ProjectReference Include="..\..\src\Headless.Encryption.PostgreSql\Headless.Encryption.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Encryption.SqlServer\Headless.Encryption.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Dashboard\Headless.Messaging.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Dashboard.Consul\Headless.Messaging.Dashboard.Consul.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Dashboard.K8s\Headless.Messaging.Dashboard.K8s.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.InMemory\Headless.Messaging.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Kafka\Headless.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Nats\Headless.Messaging.Nats.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.RabbitMq\Headless.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Redis\Headless.Messaging.Redis.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Storage.InMemory\Headless.Messaging.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Storage.PostgreSql\Headless.Messaging.Storage.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Storage.PostgreSql.EntityFramework\Headless.Messaging.Storage.PostgreSql.EntityFramework.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Storage.SqlServer\Headless.Messaging.Storage.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.Testing\Headless.Messaging.Testing.csproj" />
    <ProjectReference Include="..\..\src\Headless.MultiTenancy\Headless.MultiTenancy.csproj" />
    <ProjectReference Include="..\..\src\Headless.RateLimiting.Dashboard\Headless.RateLimiting.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\Headless.UnitOfWork.EntityFramework\Headless.UnitOfWork.EntityFramework.csproj" />
  </ItemGroup>
  <ItemGroup Label="Generators the examples rely on, run in-process by the test">
    <ProjectReference Include="..\..\src\Headless.Jobs.SourceGenerator\Headless.Jobs.SourceGenerator.csproj" />
    <ProjectReference Include="..\..\src\Headless.Messaging.SourceGenerator\Headless.Messaging.SourceGenerator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Testing\Headless.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Label="Packages the examples name in their own usings">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>
  <ItemGroup Label="Documents under test and the preludes their examples compile against">
    <None Include="..\..\docs\llms\messaging.md" Link="Docs\messaging.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\llms\jobs.md" Link="Docs\jobs.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\llms\dashboards.md" Link="Docs\dashboards.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\llms\encryption.md" Link="Docs\encryption.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Topic files of a split guide compile against the same prelude as its entry file. -->
    <None
      Include="..\..\docs\llms\messaging\*.md"
      Link="Docs\messaging\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\docs\llms\jobs\*.md"
      Link="Docs\jobs\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\docs\llms\dashboards\*.md"
      Link="Docs\dashboards\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Compile Remove="Preludes\**" />
    <None Include="Preludes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
