<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Dashboard UI and endpoints for Headless background jobs.</Description>
    <PackageTags>headless;jobs;dashboard;dotnet</PackageTags>
    <RootNamespace>Headless.Jobs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Jobs.Composition.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Coordination.Abstractions\Headless.Coordination.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Dashboard\Headless.Dashboard.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Jobs.Abstractions\Headless.Jobs.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Jobs\Headless.Jobs.csproj" />
  </ItemGroup>
  <!--
    The front end is the Jobs dashboard module, a member of the repository-root npm workspace. Its build writes
    wwwroot/dist/modules/jobs, which embeds as Headless.Jobs.wwwroot.dist.modules.jobs.* (JobsAssets), then holds the
    module to its size budgets and writes .build-complete last, so a build whose budget step failed is not up to date.
    The stamp itself is not embedded.
  -->
  <ItemGroup>
    <DashboardSpaInput Include="$(MSBuildProjectDirectory)/wwwroot/budget.json" />
  </ItemGroup>
  <PropertyGroup>
    <DashboardSpaBuildStamp>$(MSBuildProjectDirectory)/wwwroot/dist/.build-complete</DashboardSpaBuildStamp>
  </PropertyGroup>
  <Target Name="_ExcludeDashboardSpaBuildStamp" AfterTargets="_EmbedDashboardSpa">
    <ItemGroup>
      <EmbeddedResource Remove="wwwroot/dist/.build-complete" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\DashboardSpa.targets" />
</Project>
