{
  "name": "@headless/dashboard-module-jobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run type-check && npm run build-only",
    "build-only": "vite build && node ../../Headless.Dashboard/wwwroot/packages/vite/src/cli.ts finalize dist budget.json",
    "type-check": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@headless/dashboard-sdk": "1.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@headless/dashboard-vite": "1.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
