    "vite-plugin-dynamic-base": "^1.4.1",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.6",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
