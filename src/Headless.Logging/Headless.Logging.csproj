<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Native logging profile for Headless Framework hosts: environment-aware console output, enrichment, and a startup logger.</Description>
    <PackageTags>headless;logging;console;enrichment;dotnet</PackageTags>
    <RootNamespace>Headless.Logging</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Telemetry" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Logging.Redaction\Headless.Logging.Redaction.csproj" />
  </ItemGroup>
</Project>
