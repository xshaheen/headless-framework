<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>TUS resumable-upload support for Headless Framework applications.</Description>
    <PackageTags>headless;tus;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- TusCorsDefaults exposes CorsPolicyBuilder extensions; declare the framework reference
         explicitly instead of relying on tusdotnet's transitive one. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Tus.DistributedLocks" />
    <!-- The store asks the root which tenant the current call's uploads belong to. -->
    <InternalsVisibleTo Include="Headless.Tus.S3" />
    <InternalsVisibleTo Include="Headless.Tus.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FileSignatures" />
    <PackageReference Include="tusdotnet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Context.Abstractions\Headless.Context.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.MultiTenancy.Abstractions\Headless.MultiTenancy.Abstractions.csproj" />
  </ItemGroup>
</Project>
