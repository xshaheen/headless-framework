<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Messaging integration for Headless distributed locks: pushes lock-release wake-ups to every host over the bus.</Description>
    <PackageTags>headless;distributed-locks;messaging;dotnet</PackageTags>
    <RootNamespace>Headless.DistributedLocks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.DistributedLocks.Messaging.Tests.Unit" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.DistributedLocks\Headless.DistributedLocks.csproj" />
    <ProjectReference Include="..\Headless.Messaging.Abstractions\Headless.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Messaging.Bus.Abstractions\Headless.Messaging.Bus.Abstractions.csproj" />
    <!-- Generates this assembly's MessagingModule at build time; the module ships compiled into this package, so
         consumers of the package need neither the generator nor a dependency on it. -->
    <ProjectReference
      Include="..\Headless.Messaging.SourceGenerator\Headless.Messaging.SourceGenerator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>
</Project>
