{
  "name": "headless-dashboard-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/sdk",
    "packages/vite",
    "apps/shell",
    "modules/diagnostics"
  ],
  "scripts": {
    "build": "npm run type-check && npm run build-only",
    "build-only": "vite build -c apps/shell/vite.config.ts && vite build -c modules/diagnostics/vite.config.ts && node packages/vite/src/cli.ts finalize dist",
    "type-check": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.5"
  }
}
