<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Authentication primitives and policies shared by Headless dashboard packages.</Description>
    <PackageTags>headless;dashboard;authentication;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Headless.Jobs.Dashboard" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
  </ItemGroup>
  <!--
    The shell's front end is an npm workspace (the SDK, the Vite presets, the shell app, and the built-in modules), not
    the single src/ folder eng/DashboardSpa.targets watches by default. Each workspace folder is a build input, so an
    edit under any of them reruns the npm build on the next incremental build. The items are declared before the
    import, which embeds wwwroot/dist as Headless.Dashboard.wwwroot.dist.*, the names the shell's EmbeddedFileProvider
    resolves at run time.
  -->
  <ItemGroup>
    <DashboardSpaInput
      Include="$(MSBuildProjectDirectory)/wwwroot/packages/**/*;$(MSBuildProjectDirectory)/wwwroot/apps/**/*;$(MSBuildProjectDirectory)/wwwroot/modules/**/*"
      Exclude="$(MSBuildProjectDirectory)/wwwroot/**/node_modules/**;$(MSBuildProjectDirectory)/wwwroot/**/dist/**"
    />
    <DashboardSpaInput Include="$(MSBuildProjectDirectory)/wwwroot/.npmrc" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\DashboardSpa.targets" />
</Project>
