<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>One operations dashboard for a Headless host, plus the authentication the Jobs and Messaging dashboards share.</Description>
    <PackageTags>headless;dashboard;operations;sse;authentication;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Headless.Jobs.Dashboard" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
  </ItemGroup>
  <!--
    The shell's front end is a set of members of the repository-root npm workspace (the SDK, the Vite presets, the shell
    app, and the built-in modules), not the single src/ folder eng/DashboardSpa.targets watches by default. Each member
    folder is a build input, so an edit under any of them reruns the npm build on the next incremental build; the
    targets file adds the root workspace's package.json, package-lock.json, and .npmrc. The items are declared before the
    import, which embeds wwwroot/dist as Headless.Dashboard.wwwroot.dist.*, the names the shell's EmbeddedFileProvider
    resolves at run time.
  -->
  <ItemGroup>
    <DashboardSpaInput
      Include="$(MSBuildProjectDirectory)/wwwroot/packages/**/*;$(MSBuildProjectDirectory)/wwwroot/apps/**/*;$(MSBuildProjectDirectory)/wwwroot/modules/**/*"
      Exclude="$(MSBuildProjectDirectory)/wwwroot/**/node_modules/**;$(MSBuildProjectDirectory)/wwwroot/**/dist/**"
    />
  </ItemGroup>
  <!--
    The npm build runs three steps, and the first writes dist/index.html, so index.html would mark a build whose later
    step failed as up to date. The finalize step writes .build-complete last; the stamp itself is not embedded.
  -->
  <PropertyGroup>
    <DashboardSpaBuildStamp>$(MSBuildProjectDirectory)/wwwroot/dist/.build-complete</DashboardSpaBuildStamp>
  </PropertyGroup>
  <Target Name="_ExcludeDashboardSpaBuildStamp" AfterTargets="_EmbedDashboardSpa">
    <ItemGroup>
      <EmbeddedResource Remove="wwwroot/dist/.build-complete" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\DashboardSpa.targets" />
</Project>
