<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>In-process (single-instance) provider for Headless fenced leases: TimeProvider-clock grants with process-wide generations, per-key locks held until a resource-less unit of work ends, and lock-skipping expired-lease sweeps. NOT for multi-process coordination.</Description>
    <PackageTags>headless;fencing;lease;fencing-token;in-memory;in-process;testing;dotnet</PackageTags>
    <RootNamespace>Headless.Fencing.InMemory</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Fencing.InMemory.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Fencing.Core\Headless.Fencing.Core.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
  </ItemGroup>
</Project>
