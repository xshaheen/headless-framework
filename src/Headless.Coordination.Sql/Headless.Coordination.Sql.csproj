<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The one relational membership store shared by the Headless PostgreSQL and SQL Server coordination providers, written against the Headless SQL dialect kit.</Description>
    <PackageTags>headless;coordination;database;dotnet</PackageTags>
    <RootNamespace>Headless.Coordination</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Coordination.PostgreSql" />
    <InternalsVisibleTo Include="Headless.Coordination.SqlServer" />
    <InternalsVisibleTo Include="Headless.Coordination.Sqlite" />
    <InternalsVisibleTo Include="Headless.Coordination.PostgreSql.Tests.Integration" />
    <InternalsVisibleTo Include="Headless.Coordination.SqlServer.Tests.Integration" />
    <InternalsVisibleTo Include="Headless.Coordination.Sqlite.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Coordination\Headless.Coordination.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Sql.Abstractions\Headless.Sql.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Sql\Headless.Sql.csproj" />
  </ItemGroup>
</Project>
