<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>JWT issuing, parsing, and bearer authentication for Headless APIs.</Description>
    <PackageTags>headless;api;jwt;authentication;dotnet</PackageTags>
    <RootNamespace>Headless.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Api.Composition.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Api\Headless.Api.csproj" />
  </ItemGroup>
</Project>
