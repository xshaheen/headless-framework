<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Entity Framework storage provider for Headless audit logging.</Description>
    <PackageTags>headless;audit;log;storage;entity-framework;dotnet</PackageTags>
    <RootNamespace>Headless.AuditLog</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.AuditLog.Storage.EntityFramework.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.AuditLog.Storage.EntityFramework.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.AuditLog.Abstractions\Headless.AuditLog.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.AuditLog\Headless.AuditLog.csproj" />
    <!-- TreatAsUsed: the entity configuration calls its EF extensions (ExcludeFromAudit, JsonValueComparer) and the relational APIs it brings; ReferenceTrimmer misses extension-method use here. -->
    <ProjectReference Include="..\Headless.EntityFramework\Headless.EntityFramework.csproj" TreatAsUsed="true" />
  </ItemGroup>
</Project>
