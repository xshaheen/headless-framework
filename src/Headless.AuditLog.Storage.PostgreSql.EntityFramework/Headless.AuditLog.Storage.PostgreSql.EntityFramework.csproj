    <PackageTags>headless;audit;log;storage;postgresql;entity-framework;dotnet</PackageTags>
    <RootNamespace>Headless.AuditLog.PostgreSql.EntityFramework</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.AuditLog.Storage.EntityFramework\Headless.AuditLog.Storage.EntityFramework.csproj" />
    <ProjectReference Include="..\Headless.AuditLog.Storage.PostgreSql\Headless.AuditLog.Storage.PostgreSql.csproj" />
  </ItemGroup>
</Project>
