<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>In-process IDomainEventDispatcher that runs the DI-registered handlers of Headless domain events.</Description>
    <PackageTags>headless;domain;domain-events;dotnet</PackageTags>
    <RootNamespace>Headless.Domain</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Domain\Headless.Domain.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Domain.EventDispatcher.Tests.Unit" />
  </ItemGroup>
</Project>
