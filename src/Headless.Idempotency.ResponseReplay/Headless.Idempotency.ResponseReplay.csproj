<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Stripe-style HTTP idempotency middleware for Headless API, backed by the durable Headless.Idempotency store.</Description>
    <PackageTags>headless;api;idempotency;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Idempotency.ResponseReplay.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Idempotency.ResponseReplay.Benchmarks" />
    <InternalsVisibleTo Include="Headless.Idempotency.ResponseReplay.Tests.Integration" />
    <!-- Lets NSubstitute proxy ILogger<IdempotencyMiddleware>, whose generic argument is internal. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Api.Abstractions\Headless.Api.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Api\Headless.Api.csproj" />
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Context.Abstractions\Headless.Context.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Idempotency.Abstractions\Headless.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Serializer.Abstractions\Headless.Serializer.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Update="Resources\Messages.resx" />
  </ItemGroup>
</Project>
