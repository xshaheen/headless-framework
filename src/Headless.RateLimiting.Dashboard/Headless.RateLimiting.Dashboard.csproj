<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <Description>The Rate limits module of the Headless dashboard: declared attempt-limit purposes, a one-subject lookup, and a confirmed reset of a lockout.</Description>
    <PackageTags>headless;rate-limiting;attempts;dashboard;dotnet</PackageTags>
    <RootNamespace>Headless.RateLimiting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.RateLimiting.Dashboard.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Dashboard\Headless.Dashboard.csproj" />
    <ProjectReference Include="..\Headless.RateLimiting\Headless.RateLimiting.csproj" />
  </ItemGroup>
  <!--
    The front end is the Rate limits dashboard module, a member of the repository-root npm workspace. Its build writes
    wwwroot/dist/modules/ratelimiting, which embeds as Headless.RateLimiting.wwwroot.dist.modules.ratelimiting.*
    (RateLimitingAssets), then holds the module to its size budgets and writes .build-complete last, so a build whose
    budget step failed is not up to date. The stamp itself is not embedded.
  -->
  <ItemGroup>
    <DashboardSpaInput Include="$(MSBuildProjectDirectory)/wwwroot/budget.json" />
  </ItemGroup>
  <PropertyGroup>
    <DashboardSpaBuildStamp>$(MSBuildProjectDirectory)/wwwroot/dist/.build-complete</DashboardSpaBuildStamp>
  </PropertyGroup>
  <Target Name="_ExcludeDashboardSpaBuildStamp" AfterTargets="_EmbedDashboardSpa">
    <ItemGroup>
      <EmbeddedResource Remove="wwwroot/dist/.build-complete" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\DashboardSpa.targets" />
</Project>
