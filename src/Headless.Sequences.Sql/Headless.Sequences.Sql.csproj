<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The one relational counter store shared by the Headless PostgreSQL, SQL Server, and SQLite sequences providers, written against the Headless SQL dialect kit.</Description>
    <PackageTags>headless;sequences;numbering;database;dotnet</PackageTags>
    <RootNamespace>Headless.Sequences</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Sequences.PostgreSql" />
    <InternalsVisibleTo Include="Headless.Sequences.SqlServer" />
    <InternalsVisibleTo Include="Headless.Sequences.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Sequences\Headless.Sequences.csproj" />
    <ProjectReference Include="..\Headless.Sql.Abstractions\Headless.Sql.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Sql\Headless.Sql.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
  </ItemGroup>
</Project>
