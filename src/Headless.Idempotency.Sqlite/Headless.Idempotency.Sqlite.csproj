<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>SQLite provider for Headless durable idempotency: an idempotency record table whose rows carry their own lease and generation, with database-clock leases and retention and a bounded retention purge.</Description>
    <PackageTags>headless;idempotency;idempotency-key;sqlite;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency.Sqlite</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Idempotency.Core\Headless.Idempotency.Core.csproj" />
    <ProjectReference Include="..\Headless.Sql.Sqlite\Headless.Sql.Sqlite.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Sqlite\Headless.UnitOfWork.Sqlite.csproj" />
  </ItemGroup>
</Project>
