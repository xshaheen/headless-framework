<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn source generator for Headless background jobs compile-time support.</Description>
    <PackageTags>headless;jobs;source-generator;dotnet</PackageTags>
  </PropertyGroup>
  <Import Project="..\Headless.SourceGenerators.Shared\Headless.SourceGenerators.Shared.props" />
  <ItemGroup>
    <PackageReference Include="System.Buffers" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Memory" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Numerics.Vectors" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference
      Include="System.Runtime.CompilerServices.Unsafe"
      GeneratePathProperty="true"
      PrivateAssets="all"
    />
  </ItemGroup>
  <ItemGroup Label="Packs the generator's own runtime dependencies beside it under analyzers/">
    <None
      Include="$(PkgSystem_Buffers)\lib\netstandard2.0\System.Buffers.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="$(PkgSystem_Memory)\lib\netstandard2.0\System.Memory.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="$(PkgSystem_Numerics_Vectors)\lib\netstandard2.0\System.Numerics.Vectors.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="$(PkgSystem_Runtime_CompilerServices_Unsafe)\lib\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
