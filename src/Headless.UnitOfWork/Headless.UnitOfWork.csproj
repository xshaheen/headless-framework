<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Scoped unit-of-work manager and in-process engine for Headless packages.</Description>
    <PackageTags>headless;unit-of-work;transactions;dotnet</PackageTags>
    <RootNamespace>Headless.UnitOfWork</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.UnitOfWork.EntityFramework" />
    <InternalsVisibleTo Include="Headless.UnitOfWork.PostgreSql" />
    <InternalsVisibleTo Include="Headless.UnitOfWork.SqlServer" />
    <InternalsVisibleTo Include="Headless.UnitOfWork.Tests.Harness" />
    <InternalsVisibleTo Include="Headless.UnitOfWork.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
  </ItemGroup>
</Project>
