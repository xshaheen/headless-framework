<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>FluentValidation rule that checks a file's binary signature (magic bytes) with FileSignatures.</Description>
    <PackageTags>headless;fluentvalidation;filesignatures;dotnet</PackageTags>
    <RootNamespace>Headless.FluentValidation</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FileSignatures" />
  </ItemGroup>
  <ItemGroup>
    <!-- The IFormFile signature rule builds on the same internal FileSignatureRules as the IUploadedFile one, so both stay one implementation. -->
    <InternalsVisibleTo Include="Headless.Api.FluentValidation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.FluentValidation\Headless.FluentValidation.csproj" />
  </ItemGroup>
</Project>
