<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Provider-agnostic setup, admission decisions, enlisted and autonomous completion, and retention purge for Headless durable idempotency, with each record carrying its own lease, the one relational record store the PostgreSQL and SQL Server providers share, and exactly-one-provider registration.</Description>
    <PackageTags>headless;idempotency;idempotency-key;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Idempotency.Caching" />
    <InternalsVisibleTo Include="Headless.Idempotency.InMemory" />
    <InternalsVisibleTo Include="Headless.Idempotency.PostgreSql" />
    <InternalsVisibleTo Include="Headless.Idempotency.SqlServer" />
    <InternalsVisibleTo Include="Headless.Idempotency.Sqlite" />
    <InternalsVisibleTo Include="Headless.Idempotency.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Idempotency.Abstractions\Headless.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.MultiTenancy.Abstractions\Headless.MultiTenancy.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Sql.Abstractions\Headless.Sql.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Sql\Headless.Sql.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
  </ItemGroup>
</Project>
