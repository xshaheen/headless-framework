    <TargetFramework>net10.0</TargetFramework>
    <Description>SQL Server key store for Headless field-level encryption: wrapped data keys in one table, created by resources provision, with race-safe first-key creation.</Description>
    <PackageTags>headless;encryption;envelope-encryption;sqlserver;dotnet</PackageTags>
    <RootNamespace>Headless.Encryption.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Encryption\Headless.Encryption.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Sql.SqlServer\Headless.Sql.SqlServer.csproj" />
  </ItemGroup>
</Project>
