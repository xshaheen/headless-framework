<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>PostgreSQL provider for Headless Arabic search: the immutable ar_norm function as a schema contribution, and EF Core helpers for stored, trigram-indexed search keys.</Description>
    <PackageTags>headless;search;arabic;postgresql;trigram;efcore;dotnet</PackageTags>
    <RootNamespace>Headless.Search.PostgreSql</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Search\Headless.Search.csproj" />
    <ProjectReference Include="..\Headless.Sql.PostgreSql\Headless.Sql.PostgreSql.csproj" />
  </ItemGroup>
</Project>
