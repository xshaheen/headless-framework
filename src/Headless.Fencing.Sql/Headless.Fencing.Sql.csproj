<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The one relational lease store shared by the Headless PostgreSQL, SQL Server, and SQLite fencing providers, written against the Headless SQL dialect kit.</Description>
    <PackageTags>headless;fencing;lease;fencing-token;database;dotnet</PackageTags>
    <RootNamespace>Headless.Fencing</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Fencing.PostgreSql" />
    <InternalsVisibleTo Include="Headless.Fencing.SqlServer" />
    <InternalsVisibleTo Include="Headless.Fencing.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Fencing\Headless.Fencing.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Sql.Abstractions\Headless.Sql.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Sql\Headless.Sql.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
  </ItemGroup>
</Project>
