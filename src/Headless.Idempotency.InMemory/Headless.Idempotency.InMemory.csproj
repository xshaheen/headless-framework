<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>In-process (single-instance) provider for Headless durable idempotency: TimeProvider-clock admissions with process-wide generations, per-key locks held until a resource-less unit of work ends, and a lock-skipping retention purge. NOT for multi-process deduplication.</Description>
    <PackageTags>headless;idempotency;idempotency-key;in-memory;in-process;testing;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency.InMemory</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Idempotency.InMemory.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Idempotency.Core\Headless.Idempotency.Core.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
  </ItemGroup>
</Project>
