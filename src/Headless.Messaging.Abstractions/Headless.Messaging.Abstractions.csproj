<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contracts and shared abstractions for Headless messaging packages.</Description>
    <PackageTags>headless;messaging;dotnet</PackageTags>
    <RootNamespace>Headless.Messaging</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Messaging" />
    <InternalsVisibleTo Include="Headless.Messaging.Aws" />
    <InternalsVisibleTo Include="Headless.Messaging.AzureServiceBus" />
    <InternalsVisibleTo Include="Headless.Messaging.Kafka" />
    <InternalsVisibleTo Include="Headless.Messaging.Nats" />
    <InternalsVisibleTo Include="Headless.Messaging.Pulsar" />
    <InternalsVisibleTo Include="Headless.Messaging.RabbitMq" />
    <InternalsVisibleTo Include="Headless.EntityFramework.Messaging" />
    <!-- Grants Tests.Unit access to internal ConsumeContext.Response/ResponseType/ResponseCallbackName and MarkCompleted() for callback-capture unit assertions. -->
    <InternalsVisibleTo Include="Headless.Messaging.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.SourceGenerator.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Benchmarks" />
    <InternalsVisibleTo Include="Headless.Messaging.Aws.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.AzureServiceBus.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Kafka.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Nats.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Pulsar.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.RabbitMq.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Reliability.Abstractions\Headless.Reliability.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
