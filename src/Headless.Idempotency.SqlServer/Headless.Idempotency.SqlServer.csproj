<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>SQL Server provider for Headless durable idempotency: an idempotency record table locked and written inside the same transaction as its fenced lease, with database-clock retention and a bounded retention purge.</Description>
    <PackageTags>headless;idempotency;idempotency-key;fencing;sql-server;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.Idempotency.Core\Headless.Idempotency.Core.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork\Headless.UnitOfWork.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.SqlServer\Headless.UnitOfWork.SqlServer.csproj" />
  </ItemGroup>
</Project>
