    <Description>Provider-agnostic setup, policy, and tenant key resolution for Headless tenant-scoped sequences, with exactly-one-provider registration.</Description>
    <PackageTags>headless;sequences;numbering;dotnet</PackageTags>
    <RootNamespace>Headless.Sequences</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Sequences.PostgreSql" />
    <InternalsVisibleTo Include="Headless.Sequences.SqlServer" />
