<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Pulsar integration for Headless messaging.</Description>
    <PackageTags>headless;messaging;pulsar;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Messaging.Pulsar.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Pulsar.Tests.Integration" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DotPulsar" />
    <!-- DotPulsar finds its LZ4, Snappy, and Zstandard codecs by reflection, so the compiler never sees them used. Each is
         needed to decode a message compressed with that codec, by any producer, and to publish with it. -->
    <PackageReference Include="IronSnappy" TreatAsUsed="true" />
    <PackageReference Include="K4os.Compression.LZ4" TreatAsUsed="true" />
    <PackageReference Include="ZstdSharp.Port" TreatAsUsed="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Headless.Messaging\Headless.Messaging.csproj" />
    <ProjectReference Include="..\Headless.Messaging.Bus.Abstractions\Headless.Messaging.Bus.Abstractions.csproj" />
    <ProjectReference Include="..\Headless.Messaging.Queue.Abstractions\Headless.Messaging.Queue.Abstractions.csproj" />
  </ItemGroup>
</Project>
