<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Dashboard UI and endpoints for Headless messaging.</Description>
    <PackageTags>headless;messaging;dashboard;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard.Consul" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard.Consul.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard.K8s" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard.K8s.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Messaging.Dashboard.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Dashboard\Headless.Dashboard.csproj" />
    <ProjectReference Include="..\Headless.Messaging\Headless.Messaging.csproj" />
  </ItemGroup>
  <!--
    The front end is the Messaging dashboard module, a member of the repository-root npm workspace. Its build writes
    wwwroot/dist/modules/messaging, which embeds as Headless.Messaging.Dashboard.wwwroot.dist.modules.messaging.*
    (MessagingAssets), then holds the module to its size budgets and writes .build-complete last, so a build whose
    budget step failed is not up to date. The stamp itself is not embedded.
  -->
  <ItemGroup>
    <DashboardSpaInput Include="$(MSBuildProjectDirectory)/wwwroot/budget.json" />
  </ItemGroup>
  <PropertyGroup>
    <DashboardSpaBuildStamp>$(MSBuildProjectDirectory)/wwwroot/dist/.build-complete</DashboardSpaBuildStamp>
  </PropertyGroup>
  <Target Name="_ExcludeDashboardSpaBuildStamp" AfterTargets="_EmbedDashboardSpa">
    <ItemGroup>
      <EmbeddedResource Remove="wwwroot/dist/.build-complete" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\DashboardSpa.targets" />
</Project>
