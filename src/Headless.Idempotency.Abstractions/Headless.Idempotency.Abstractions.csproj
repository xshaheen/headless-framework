<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contracts for Headless durable idempotency: tenant-scoped admission of a keyed operation with a versioned request fingerprint, replay of its stored result, and the unit-of-work accessor that admits, fences, and completes inside the caller's transaction.</Description>
    <PackageTags>headless;idempotency;idempotency-key;unit-of-work;dotnet</PackageTags>
    <RootNamespace>Headless.Idempotency</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.UnitOfWork.Abstractions\Headless.UnitOfWork.Abstractions.csproj" />
  </ItemGroup>
</Project>
