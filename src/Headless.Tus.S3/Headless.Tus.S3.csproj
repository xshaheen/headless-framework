<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Amazon S3, Cloudflare R2, and S3-compatible integration for Headless TUS uploads.</Description>
    <PackageTags>headless;tus;s3;r2;aws;dotnet</PackageTags>
    <RootNamespace>Headless.Tus</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Tus.Tests.Unit" />
    <InternalsVisibleTo Include="Headless.Tus.S3.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
  <ItemGroup>
    <!-- TreatAsUsed: supplies the tusdotnet store contracts this package implements. -->
    <ProjectReference Include="..\Headless.Tus\Headless.Tus.csproj" TreatAsUsed="true" />
  </ItemGroup>
</Project>
