<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>In-process subscription hub, setup builder, options, and metrics for Headless live queries: a query re-runs when a committed write touches what it read.</Description>
    <PackageTags>headless;live-queries;realtime;dotnet</PackageTags>
    <RootNamespace>Headless.LiveQueries</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.LiveQueries.Endpoints" />
    <InternalsVisibleTo Include="Headless.LiveQueries.EntityFramework" />
    <InternalsVisibleTo Include="Headless.LiveQueries.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Supplies the extended LoggerMessage generator, which accepts the _PascalCase private logging methods the built-in generator rejects (SYSLIB1001). -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Checks\Headless.Checks.csproj" />
    <ProjectReference Include="..\Headless.Hosting\Headless.Hosting.csproj" />
    <ProjectReference Include="..\Headless.LiveQueries.Abstractions\Headless.LiveQueries.Abstractions.csproj" />
  </ItemGroup>
</Project>
