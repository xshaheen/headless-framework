<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Headless enrichment for ASP.NET Core OpenAPI documents: schema, security, problem-details, and FluentValidation transformers.</Description>
    <PackageTags>headless;openapi;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Headless.OpenApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Api\Headless.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive\*.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
