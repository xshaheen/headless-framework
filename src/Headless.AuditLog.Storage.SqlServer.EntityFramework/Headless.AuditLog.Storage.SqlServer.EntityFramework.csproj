    <PackageTags>headless;audit;log;storage;sqlserver;entity-framework;dotnet</PackageTags>
    <RootNamespace>Headless.AuditLog.SqlServer.EntityFramework</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.AuditLog.Storage.EntityFramework\Headless.AuditLog.Storage.EntityFramework.csproj" />
    <ProjectReference Include="..\Headless.AuditLog.Storage.SqlServer\Headless.AuditLog.Storage.SqlServer.csproj" />
  </ItemGroup>
</Project>
