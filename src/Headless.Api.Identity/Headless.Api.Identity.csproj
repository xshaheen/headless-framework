<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>ASP.NET Core Identity integration for Headless APIs: token providers, localized identity errors, lookup normalization, and Identity-backed Basic and API-key authentication.</Description>
    <PackageTags>headless;api;identity;authentication;dotnet</PackageTags>
    <RootNamespace>Headless.Api.Identity</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Headless.Api.Composition.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Humanizer.Core" />
    <!-- The throttling messages ship in Arabic (Messages.ar.resx), so the durations Humanizer formats into them need its Arabic resources too. -->
    <PackageReference Include="Humanizer.Core.ar" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Api\Headless.Api.csproj" />
    <ProjectReference Include="..\Headless.Security.Abstractions\Headless.Security.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Update="Resources\Messages.resx" />
  </ItemGroup>
</Project>
