<Project Sdk="Headless.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contracts and shared abstractions for Headless multi-tenancy packages.</Description>
    <PackageTags>headless;multi-tenancy;dotnet</PackageTags>
    <RootNamespace>Headless.MultiTenancy</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Headless.Extensions\Headless.Extensions.csproj" />
    <ProjectReference Include="..\Headless.Primitives\Headless.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- HeadlessTenancyBuilder's constructor is internal: only the tenancy root setup constructs the builder. -->
    <InternalsVisibleTo Include="Headless.MultiTenancy" />
    <InternalsVisibleTo Include="Headless.MultiTenancy.Tests.Unit" />
  </ItemGroup>
</Project>
