<Project Sdk="Headless.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The OpenAPI XML-comment generator reads this project's documentation file at compile time. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A demo documents the members it shows in OpenAPI, not every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Headless.Api.Abstractions\Headless.Api.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Headless.OpenApi\Headless.OpenApi.csproj" />
    <ProjectReference Include="..\..\src\Headless.OpenApi.Scalar\Headless.OpenApi.Scalar.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Referenced directly so its build targets enable the XML-comment interceptors for AddOpenApi below. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
</Project>
